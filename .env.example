# Cloud LLM API Keys (Configure in .env.local for local dev or Vercel Project Settings -> Environment Variables)
# Primary: Anthropic Claude API Key
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-3-5-sonnet-latest / claude-3-7-sonnet-latest fallback)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional alternative provider keys (supported automatically if ANTHROPIC_API_KEY is not set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Demo Access Protection Key
DEMO_KEY=
VITE_DEMO_KEY=
